# Cloudflare Pages / Netlify 공용 헤더 설정 — 허브 + 강사 사이트 일괄 배포
# sites/ 를 배포 루트로 올리면 이 파일이 자동 적용됩니다 (재빌드해도 유지됨).
# 사진·OG 이미지 등 정적 자산 1년 캐시 — 파일명이 바뀌면 새로 내려받습니다.
/*/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 보안 기본 헤더
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
